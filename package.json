	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:remote": "npx wrangler dev --remote",
		"dev:local": "npm run build:cf && npx wrangler dev --local",
		"build": "next build",
		"build:cf": "opennextjs-cloudflare build",
		"preview": "npm run build:cf && opennextjs-cloudflare preview",
		"deploy": "npm run build:cf && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
		"check": "next build && tsc",
		"lint": "next lint",
		"seed": "npx wrangler d1 execute d1-database-id-1 --remote --file=./seed.sql",
		"seed:local": "npx wrangler d1 execute d1-database-id-1 --local --file=./seed.sql",
		"build:worker": "cloudflare",
		"preview:remote": "npm run build:worker && wrangler dev --remote",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest  --coverage",
		"test:watch": "vitest  --watch",
		"test:debug": "vitest --inspect --no-file-parallelism",
		"preview:debug": "OPEN_NEXT_DEBUG=true opennextjs-cloudflare build && opennextjs-cloudflare preview"
	},
	"allowScripts": {
		"sharp@0.35.4": true,
		"sharp@0.34.5": true,
